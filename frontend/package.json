{
  "name": "agentlens-frontend",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:assets": "node scripts/sync-assets.mjs",
    "sync:styles": "npm run sync:assets",
    "test": "node --test test/*.test.mjs",
    "predev": "npm run sync:assets",
    "dev": "node scripts/vite-no-net-use.mjs --configLoader native --host 127.0.0.1",
    "prebuild": "npm run sync:assets",
    "build": "node scripts/vite-no-net-use.mjs build --configLoader native",
    "preview": "node scripts/vite-no-net-use.mjs preview --configLoader native --host 127.0.0.1"
  },
  "dependencies": {
    "@formkit/auto-animate": "0.10.0",
    "@vitejs/plugin-react": "4.7.0",
    "fuse.js": "7.1.0",
    "markdown-it": "14.3.1",
    "parse-diff": "0.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "4.12.3",
    "thinking-orbs": "0.2.0",
    "vite": "6.4.3"
  }
