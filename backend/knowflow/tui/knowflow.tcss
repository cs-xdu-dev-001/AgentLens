Screen {
    background: $background;
    color: $text;
    layout: vertical;
}

#transcript {
    height: 1fr;
    padding: 1 3;
    scrollbar-size: 1 1;
}

.welcome-heading {
    width: 100%;
    height: 3;
    padding: 1 2 0 2;
    border-top: round gray;
    border-left: round gray;
    border-right: round gray;
    background: $surface;
}

.welcome-summary {
    width: 100%;
    height: 3;
    padding: 0 2;
    border-left: round gray;
    border-right: round gray;
    border-bottom: round gray;
    background: $surface;
}

.welcome-tip {
    width: 100%;
    height: 2;
    padding: 1 2 0 2;
    margin-bottom: 1;
    color: $text-muted;
}

.message {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.user-message {
    padding: 0 1;
    color: $text;
}

.assistant-message {
    padding: 0 3;
}

.run-activity {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 0 3 1 3;
}

.run-activity.failed {
    color: $error;
}

.activity-header {
    height: 1;
    color: $text-muted;
}

.activity-steps {
    height: auto;
    padding-top: 1;
}

.activity-step {
    width: 100%;
    height: auto;
    color: $text-muted;
}

.activity-step.active {
    color: $text;
}

.activity-step.failed {
    color: $error;
}

.notice {
    width: 100%;
    height: auto;
    padding: 0 3;
    margin-bottom: 1;
    color: $warning;
}

.error-notice {
    color: $error;
}

#bottom-pane {
    height: auto;
    padding: 0 3 1 3;
    background: $background;
}

#run-status {
    width: 100%;
    height: 1;
    padding-left: 2;
    color: $text-muted;
}

#command-menu {
    display: none;
    width: 100%;
    max-height: 9;
    height: auto;
    padding: 1 2;
    border: none;
    background: $surface;
}

#command-menu.visible {
    display: block;
}

.command-option {
    width: 100%;
    height: 1;
    padding: 0;
    color: $text-muted;
}

.command-option.selected {
    color: $text;
    background: $primary 12%;
}

#composer-row {
    width: 100%;
    height: 3;
    border: round gray;
    background: $surface;
}

#composer-prefix {
    width: 3;
    height: 100%;
    padding-left: 1;
    content-align: center middle;
    color: $primary;
    text-style: bold;
}

#composer {
    width: 1fr;
    height: 100%;
    border: none;
    padding: 0;
    background: $surface;
}

#composer:focus {
    border: none;
}

#status-bar {
    height: 1;
    padding-left: 2;
    color: $text-disabled;
}

ApprovalScreen {
    align: center middle;
    background: $background 65%;
}

#approval-dialog {
    width: 58;
    height: auto;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}

.approval-title {
    height: 1;
    text-style: bold;
}

.approval-body {
    height: auto;
    margin: 1 0;
}

.approval-detail {
    height: auto;
    max-height: 8;
    padding: 1;
    margin-bottom: 1;
    background: $background;
    color: $text-muted;
}

.approval-actions {
    height: 3;
    align-horizontal: right;
}

.approval-actions Button {
    margin-left: 1;
}
