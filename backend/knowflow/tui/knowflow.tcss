Screen {
    background: $background;
    color: $text;
    layout: vertical;
}

#transcript {
    height: 1fr;
    padding: 1 2;
    scrollbar-size: 1 1;
}

.welcome-panel {
    width: 58;
    max-width: 100%;
    height: auto;
    min-height: 11;
    padding: 1 2;
    margin: 0 0 2 0;
    border: round #d97757;
    background: $background;
}

.welcome-brand {
    width: 100%;
    height: 5;
    text-style: bold;
}

.welcome-context {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $text-muted;
}

.welcome-tip {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $text-muted;
}

.message {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.user-message {
    padding: 0 1;
    color: $text;
}

.assistant-message {
    padding: 0 2;
}

.run-activity {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 0 2 1 2;
}

.run-activity.failed {
    color: $error;
}

.run-activity.cancelled {
    color: $text-muted;
}

.activity-header {
    height: 1;
    color: $text-muted;
}

.activity-steps {
    height: auto;
    padding-top: 1;
}

.activity-step {
    width: 100%;
    height: auto;
    padding: 0;
    border: none;
    background: $background;
    color: $text-muted;
}

.activity-detail {
    width: 100%;
    height: auto;
    max-height: 10;
    padding: 0 2 1 4;
    color: $text-muted;
    overflow-y: auto;
    scrollbar-size: 1 1;
}

.activity-step.active {
    color: $text;
}

.activity-step.failed {
    color: $error;
}

.notice {
    width: 100%;
    height: auto;
    padding: 0 2;
    margin-bottom: 1;
    color: $warning;
}

.error-notice {
    color: $error;
}

.recovery-notice {
    width: 100%;
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    color: $text;
    border-top: solid #555555;
}

.error-recovery {
    color: $error;
}

.archive-summary {
    width: 100%;
    height: 1;
    padding: 0 2;
    margin-bottom: 1;
    color: $text-muted;
}

.archived-message {
    opacity: 70%;
}

#bottom-pane {
    height: auto;
    padding: 0 2 1 2;
    background: $background;
}

#prompt-footer {
    width: 100%;
    height: 1;
    padding: 0 2;
}

#run-status {
    width: 1fr;
    height: 1;
    color: $text-muted;
}

#command-menu {
    display: none;
    width: 100%;
    max-height: 11;
    height: auto;
    padding: 0 2;
    border: none;
    background: $background;
}

#command-menu.visible {
    display: block;
}

.command-menu-title {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $text-muted;
}

#command-options {
    width: 100%;
    height: auto;
    max-height: 9;
    border: none;
    background: $background;
    scrollbar-size: 1 1;
}

#command-options > .option-list--option-highlighted {
    color: $background;
    background: #d97757;
    text-style: bold;
}

#composer-row {
    width: 100%;
    height: 5;
    border-top: round #d97757;
    border-bottom: round #d97757;
    border-left: none;
    border-right: none;
    background: $background;
}

#composer-prefix {
    width: 3;
    height: 100%;
    padding-left: 1;
    content-align: center middle;
    color: #d97757;
    text-style: bold;
}

#composer {
    width: 1fr;
    height: 100%;
    border: none;
    padding: 0;
    background: $background;
}

#composer:focus {
    border: none;
}

#history-search {
    display: none;
    width: 100%;
    height: 3;
    padding: 0 1;
    border-bottom: solid #d97757;
    background: $background;
}

#history-search.visible {
    display: block;
}

#queue-preview {
    display: none;
    width: 100%;
    height: auto;
    max-height: 3;
    padding: 0 2 1 2;
    color: $text-muted;
}

#queue-preview.visible {
    display: block;
}

#history-search-label {
    width: 12;
    height: 3;
    content-align: left middle;
    color: #d97757;
}

#history-search-input {
    width: 1fr;
    height: 3;
    border: none;
    background: $background;
}

#status-bar {
    width: 1fr;
    height: 1;
    text-align: right;
    color: $text-disabled;
}

Screen.narrow #transcript {
    padding: 1;
}

Screen.narrow .welcome-panel {
    min-height: 7;
    padding: 0 1;
    margin-bottom: 1;
}

Screen.narrow .welcome-context,
Screen.narrow .welcome-tip {
    display: none;
}

Screen.narrow #bottom-pane {
    padding: 0 1 1 1;
}

Screen.narrow #command-menu {
    max-height: 8;
}

Screen.narrow #command-options {
    max-height: 6;
}

Screen.narrow #composer-row {
    height: 4;
}

Screen.narrow #prompt-footer {
    padding: 0;
}

Screen.narrow #run-status {
    width: 100%;
}

Screen.narrow #history-search-label {
    width: 10;
}

Screen.narrow #queue-preview {
    max-height: 4;
    padding: 0 0 1 0;
}

Screen.narrow #status-bar {
    display: none;
}

CommandBrowserScreen,
QueueManagerScreen,
PermissionModeScreen,
PermissionRuleScreen {
    align: center middle;
    background: $background 65%;
}

#command-browser-dialog,
#queue-manager-dialog,
#permission-mode-dialog,
#permission-rules-dialog {
    width: 78;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    border: round #d97757;
    background: $surface;
}

#command-browser-tabs,
#permission-rule-tabs,
.permission-title {
    height: 1;
    text-style: bold;
}

#permission-rule-description {
    height: auto;
    margin: 1 0;
    color: $text-muted;
}

#command-browser-options {
    width: 100%;
    height: 16;
    border: none;
    background: $surface;
}

.queue-manager-title {
    height: 1;
    text-style: bold;
}

#queue-manager-summary {
    height: 1;
    margin: 1 0;
    color: $text-muted;
}

#queue-manager-options {
    width: 100%;
    height: 12;
    border: none;
    background: $surface;
}

#permission-mode-dialog {
    width: 72;
}

#permission-mode-options {
    width: 100%;
    height: 9;
    margin-top: 1;
    border: none;
    background: $surface;
}

#permission-rule-input {
    display: block;
    width: 100%;
    height: 3;
    margin-bottom: 1;
    border: none;
    border-bottom: solid #555555;
    background: $surface;
}

#permission-rule-input:focus {
    border-bottom: solid #d97757;
}

#permission-rule-options {
    width: 100%;
    height: 8;
    border: none;
    background: $surface;
}

#command-browser-options:focus > .option-list--option-highlighted,
#queue-manager-options:focus > .option-list--option-highlighted,
#permission-mode-options:focus > .option-list--option-highlighted,
#permission-rule-options:focus > .option-list--option-highlighted {
    color: $background;
    background: #d97757;
    text-style: bold;
}

.permission-footer,
.queue-manager-footer,
.command-browser-footer {
    height: 1;
    margin-top: 1;
    color: $text-muted;
}

Screen.narrow #command-browser-dialog,
Screen.narrow #queue-manager-dialog,
Screen.narrow #permission-mode-dialog,
Screen.narrow #permission-rules-dialog {
    width: 100%;
    padding: 1;
}

Screen.narrow #command-browser-options,
Screen.narrow #queue-manager-options,
Screen.narrow #permission-mode-options,
Screen.narrow #permission-rule-options {
    height: 8;
}

Screen.narrow .queue-manager-footer {
    height: auto;
}

ApprovalScreen {
    align: center middle;
    background: $background 65%;
}

#approval-dialog {
    width: 58;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}

.approval-title {
    height: 1;
    text-style: bold;
}

.approval-body {
    height: auto;
    margin: 1 0;
}

.approval-detail {
    height: auto;
    max-height: 8;
    padding: 1;
    margin-bottom: 1;
    background: $background;
    color: $text-muted;
}

.approval-actions {
    height: 3;
    align-horizontal: right;
}

.approval-actions Button {
    margin-left: 1;
}

Screen.narrow #approval-dialog {
    width: 100%;
    padding: 1;
}

Screen.narrow .approval-actions {
    height: auto;
    layout: vertical;
    align-horizontal: center;
}

Screen.narrow .approval-actions Button {
    width: 100%;
    margin: 0 0 1 0;
}
