Screen {
    background: $background;
    color: $text;
    layout: vertical;
}

#transcript {
    height: 1fr;
    padding: 1 2;
    scrollbar-size: 1 1;
}

.welcome-panel {
    width: 58;
    max-width: 100%;
    height: auto;
    min-height: 11;
    padding: 1 2;
    margin: 0 0 2 0;
    border: round #d97757;
    background: $background;
}

.welcome-brand {
    width: 100%;
    height: 5;
    text-style: bold;
}

.welcome-context {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $text-muted;
}

.welcome-tip {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $text-muted;
}

.message {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.user-message {
    padding: 0 1;
    color: $text;
}

.assistant-message {
    padding: 0 2;
}

.run-activity {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 0 2 1 2;
}

.run-activity.failed {
    color: $error;
}

.activity-header {
    height: 1;
    color: $text-muted;
}

.activity-steps {
    height: auto;
    padding-top: 1;
}

.activity-step {
    width: 100%;
    height: auto;
    color: $text-muted;
}

.activity-step.active {
    color: $text;
}

.activity-step.failed {
    color: $error;
}

.notice {
    width: 100%;
    height: auto;
    padding: 0 2;
    margin-bottom: 1;
    color: $warning;
}

.error-notice {
    color: $error;
}

#bottom-pane {
    height: auto;
    padding: 0 2 1 2;
    background: $background;
}

#prompt-footer {
    width: 100%;
    height: 1;
    padding: 0 2;
}

#run-status {
    width: 1fr;
    height: 1;
    color: $text-muted;
}

#command-menu {
    display: none;
    width: 100%;
    max-height: 10;
    height: auto;
    padding: 0 2;
    border: none;
    background: $background;
}

#command-menu.visible {
    display: block;
}

.command-menu-title {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $text-muted;
}

.command-option {
    width: 100%;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

.command-option.selected {
    color: $text;
    background: #d97757 16%;
}

#composer-row {
    width: 100%;
    height: 3;
    border-top: round #d97757;
    border-bottom: round #d97757;
    border-left: none;
    border-right: none;
    background: $background;
}

#composer-prefix {
    width: 3;
    height: 100%;
    padding-left: 1;
    content-align: center middle;
    color: #d97757;
    text-style: bold;
}

#composer {
    width: 1fr;
    height: 100%;
    border: none;
    padding: 0;
    background: $background;
}

#composer:focus {
    border: none;
}

#status-bar {
    width: 1fr;
    height: 1;
    text-align: right;
    color: $text-disabled;
}

Screen.narrow #transcript {
    padding: 1;
}

Screen.narrow .welcome-panel {
    min-height: 7;
    padding: 0 1;
    margin-bottom: 1;
}

Screen.narrow .welcome-context,
Screen.narrow .welcome-tip {
    display: none;
}

Screen.narrow #bottom-pane {
    padding: 0 1 1 1;
}

Screen.narrow #command-menu {
    max-height: 7;
}

Screen.narrow #status-bar {
    display: none;
}

ApprovalScreen {
    align: center middle;
    background: $background 65%;
}

#approval-dialog {
    width: 58;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}

.approval-title {
    height: 1;
    text-style: bold;
}

.approval-body {
    height: auto;
    margin: 1 0;
}

.approval-detail {
    height: auto;
    max-height: 8;
    padding: 1;
    margin-bottom: 1;
    background: $background;
    color: $text-muted;
}

.approval-actions {
    height: 3;
    align-horizontal: right;
}

.approval-actions Button {
    margin-left: 1;
}

Screen.narrow #approval-dialog {
    width: 100%;
    padding: 1;
}

Screen.narrow .approval-actions {
    height: auto;
    layout: vertical;
    align-horizontal: center;
}

Screen.narrow .approval-actions Button {
    width: 100%;
    margin: 0 0 1 0;
}
