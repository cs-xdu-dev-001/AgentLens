# Runtime mode
# sqlite is easiest for local demos; mysql matches the final design.
KNOWFLOW_DB_URL=sqlite:///./data/knowflow.db
KNOWFLOW_UPLOAD_DIR=./data/uploads
# Example MySQL:
# KNOWFLOW_DB_URL=mysql+pymysql://root:123456@127.0.0.1:3306/knowflow_ai?charset=utf8mb4

# Skill packages are per-user packages stored below this directory.
# scripts/ files are stored and inspected only; they are never executed.
KNOWFLOW_SKILL_DIR=./data/skills
KNOWFLOW_SKILL_MAX_ARCHIVE_BYTES=5242880
KNOWFLOW_SKILL_MAX_EXTRACTED_BYTES=20971520
KNOWFLOW_SKILL_MAX_FILES=200
KNOWFLOW_SKILL_MAX_FILE_BYTES=2097152
KNOWFLOW_SKILL_MAX_DEPTH=8
KNOWFLOW_SKILL_MAX_BODY_CHARS=50000
KNOWFLOW_SKILL_IMPORT_TTL=900
KNOWFLOW_SKILL_GITHUB_TIMEOUT=15

# Vector backend: local or chroma
KNOWFLOW_VECTOR_BACKEND=local
KNOWFLOW_CHROMA_DIR=./data/chroma

# Used to encrypt API keys in model_config and tool_config.
# Change this before using real keys.
KNOWFLOW_SECRET_KEY=change-this-dev-secret

# Web search runtime limits. Each user stores their own Tavily key in Settings.
KNOWFLOW_WEB_SEARCH_TIMEOUT=15
KNOWFLOW_WEB_SEARCH_MAX_RESULTS=5

# Mem0 OSS long-term memory. Keep disabled until the dedicated model keys are set.
# Memory uses a server-level extraction model and embedder; users only control
# their own enable switch and can never see another user's memory namespace.
MEM0_TELEMETRY=False
KNOWFLOW_MEMORY_ENABLED=0
KNOWFLOW_MEMORY_DEFAULT_ENABLED=0
KNOWFLOW_MEMORY_LLM_API_KEY=''
KNOWFLOW_MEMORY_LLM_MODEL=gpt-5-mini
KNOWFLOW_MEMORY_LLM_BASE_URL=https://api.openai.com/v1
# Leave empty to reuse KNOWFLOW_MEMORY_LLM_API_KEY.
KNOWFLOW_MEMORY_EMBEDDER_API_KEY=''
KNOWFLOW_MEMORY_EMBEDDER_MODEL=text-embedding-3-small
KNOWFLOW_MEMORY_EMBEDDER_BASE_URL=https://api.openai.com/v1
KNOWFLOW_MEMORY_EMBEDDING_DIMS=1536
KNOWFLOW_MEMORY_QDRANT_PATH=./data/mem0/qdrant
KNOWFLOW_MEMORY_HISTORY_DB=./data/mem0/history.db
KNOWFLOW_MEMORY_TOP_K=5
KNOWFLOW_MEMORY_LIST_LIMIT=100
KNOWFLOW_MEMORY_SEARCH_THRESHOLD=0.2

# Agent execution engine: "current" or model-only "langgraph".
# Keep "current" for tools, MCP, Skills, approvals, and memory workflows.
KNOWFLOW_AGENT_ENGINE=current
KNOWFLOW_LANGGRAPH_CHECKPOINT_DB=./data/langgraph/checkpoints.sqlite3

# Agent task state is persisted in the database, but active execution is process-local.
# Run one backend worker; after a service restart, users resume interrupted tasks manually.

# Public base URL used by OAuth callbacks.
KNOWFLOW_BASE_URL=http://127.0.0.1:8010
# Frontend origins allowed as OAuth return targets. Match scheme, host, and port exactly.
KNOWFLOW_OAUTH_RETURN_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Remote MCP limits. Private-network access is unsafe and disabled by default.
KNOWFLOW_MCP_CONNECT_TIMEOUT=10
KNOWFLOW_MCP_REQUEST_TIMEOUT=30
KNOWFLOW_MCP_APPROVAL_TIMEOUT=300
KNOWFLOW_MCP_MAX_RESPONSE_BYTES=1048576
KNOWFLOW_MCP_MAX_EXPOSED_TOOLS=32
KNOWFLOW_MCP_ALLOW_PRIVATE_NETWORKS=0

# GitHub OAuth Login.
# GitHub OAuth App callback URL:
# http://127.0.0.1:8010/api/auth/oauth/github/callback
KNOWFLOW_GITHUB_CLIENT_ID=
KNOWFLOW_GITHUB_CLIENT_SECRET=

# Set to 1 only when serving HTTPS.
KNOWFLOW_COOKIE_SECURE=0
KNOWFLOW_AUTH_SESSION_TTL=604800
# Set to 1 only if you intentionally want the first signed-in user to adopt legacy rows with NULL user_id.
KNOWFLOW_ADOPT_LEGACY_DATA=0

# Retrieval defaults
KNOWFLOW_CHUNK_SIZE=800
KNOWFLOW_CHUNK_OVERLAP=120
KNOWFLOW_TOP_K=5
KNOWFLOW_RAG_SCORE_THRESHOLD=0.25
